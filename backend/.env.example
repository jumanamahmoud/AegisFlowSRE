# Copy this file to .env and fill in your values.
# .env is git-ignored. NEVER put real values in this example file.

# --- TypeSafe Jev (System 1 triage) ------------------------------------------
# Obtain from https://console.typesafe.ai/keys (JEV_API_KEY is accepted as an alias)
TYPESAFE_API_KEY=
# Pin the model so thresholds don't drift when TypeSafe ships a new release.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# --- Groq (System 2 analysis) -------------------------------------------------
GROQ_API_KEY=
# Comma-separated, tried in order; falls back to a rule-based summary if all fail.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Output token budget per Groq call (gpt-oss spends part of it on hidden reasoning).
GROQ_MAX_TOKENS=4096
# Set to 0 to stop printing model reasoning / analysis to the console.
AEGIS_VERBOSE=1

# --- Neo4j (service map) ------------------------------------------------------
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Optional: path to a CA bundle (e.g. certifi's cacert.pem) if TLS verification fails locally.
NEO4J_CA_BUNDLE=

# --- Supabase (incidents, analyses, audit timeline) --------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# SECRET key (sb_secret_...) from Dashboard -> Project Settings -> API Keys.
# Server-side only. The publishable key is rejected by the backend.
SUPABASE_SECRET_KEY=

# --- API ----------------------------------------------------------------------
# JSON list of allowed browser origins. Defaults to ["*"] if unset.
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Tests --------------------------------------------------------------------
# Set to 1 to run tests/test_integration_supabase.py against the real project
# (requires the migration in supabase/migrations to be applied).
# AEGIS_RUN_INTEGRATION=0
